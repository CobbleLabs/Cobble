namespace {

static jmethodID getSendPacketMethod(JNIEnv* env, jobject netHandler) {
    static jmethodID mid_sendPacket = nullptr;
    if (mid_sendPacket || !env || !netHandler)
        return mid_sendPacket;

    jclass cls = env->GetObjectClass(netHandler);
    if (!cls)
        return nullptr;

    mid_sendPacket = env->GetMethodID(cls, "addToSendQueue", "(Lnet/minecraft/network/Packet;)V");
    if (!mid_sendPacket) {
        env->ExceptionClear();
        mid_sendPacket = env->GetMethodID(cls, "func_147297_a", "(Lnet/minecraft/network/Packet;)V");
    }
    if (!mid_sendPacket) {
        env->ExceptionClear();
        mid_sendPacket = env->GetMethodID(cls, "sendPacket", "(Lnet/minecraft/network/Packet;)V");
    }
    env->DeleteLocalRef(cls);
    return mid_sendPacket;
}

static jobject getNetHandler(JNIEnv* env) {
    if (!env || !mc.isValid() || !JniCache::mid_getNetHandler)
        return nullptr;
    jobject netHandler = env->CallObjectMethod(mc.instance, JniCache::mid_getNetHandler);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
        if (netHandler)
            env->DeleteLocalRef(netHandler);
        return nullptr;
    }
    return netHandler;
}

static bool sendPacket(JNIEnv* env, jobject packet) {
    if (!env || !packet)
        return false;

    jobject netHandler = getNetHandler(env);
    if (!netHandler)
        return false;

    jmethodID mid = getSendPacketMethod(env, netHandler);
    if (!mid) {
        env->DeleteLocalRef(netHandler);
        return false;
    }

    env->CallVoidMethod(netHandler, mid, packet);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
    }
    env->DeleteLocalRef(netHandler);
    return true;
}

}  // namespace

Criticals::Criticals() : Module("Criticals") {
    keybind = 0;
}

void Criticals::onEnable() {
    isDelaying = false;
    delayStartTime = 0;
    wasAttacking = false;
    ticksSinceAttack = 0;
    clearQueuedPackets();
    log_debug("[Criticals] Enabled");
}

void Criticals::onDisable() {
    isDelaying = false;
    flushQueuedPackets();
    log_debug("[Criticals] Disabled");
}

bool Criticals::isHoldingSword() {
    int itemId = player.getHeldItemId();
    // Swords: 268 (wood), 272 (stone), 267 (iron), 276 (diamond), 283 (gold)
    return (itemId == 268 || itemId == 272 || itemId == 267 || itemId == 276 || itemId == 283);
}

bool Criticals::isLookingAtPlayer() {
    JNIEnv* env = Java::Env();
    if (!env || !mc.isValid())
        return false;

    // Check objectMouseOver
    if (!JniCache::fid_objectMouseOver || !JniCache::fid_entityHit)
        return false;

    jobject mouseOver = env->GetObjectField(mc.instance, JniCache::fid_objectMouseOver);
    if (!mouseOver)
        return false;

    // Get the entityHit field from MovingObjectPosition
    jobject entityHit = env->GetObjectField(mouseOver, JniCache::fid_entityHit);
    env->DeleteLocalRef(mouseOver);

    if (!entityHit)
        return false;

    // Check if it's a player (EntityPlayer)
    bool isPlayer = JniCache::cls_EntityPlayer && env->IsInstanceOf(entityHit, JniCache::cls_EntityPlayer);
    env->DeleteLocalRef(entityHit);

    return isPlayer;
}

bool Criticals::shouldDelayPacket() {
    if (!enabled)
        return false;
    if (Menu::isOpen)
        return false;
    if (!player.isValid())
        return false;

    // Check sword condition
    if (settings.onlyWithSword && !isHoldingSword())
        return false;

    // Check if attacking (LMB pressed)
    bool isAttacking = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0;
    
    if (settings.onlyWhileAttacking && !isAttacking)
        return false;

    // Check if looking at a player
    if (settings.lookingAtPlayer && !isLookingAtPlayer())
        return false;

    // Don't delay while sneaking
    if (player.isSneaking())
        return false;

    // Only delay when in air and falling (negative motionY = falling)
    bool onGround = player.isOnGround();
    double motionY = player.getMotionY();
    
    // We want to delay packets when:
    // 1. Player is in air (not on ground)
    // 2. Player is falling (motionY < 0)
    // 3. Player is attacking
    if (!onGround && motionY < 0 && isAttacking) {
        // Start delay if not already delaying
        if (!isDelaying) {
            isDelaying = true;
            delayStartTime = GetTickCount64();
            log_debug("[Criticals] Starting packet delay (motionY=%.3f)", motionY);
        }
        
        // Check if delay has expired
        ULONGLONG elapsed = GetTickCount64() - delayStartTime;
        if (elapsed < (ULONGLONG)settings.maxDelayMs) {
            return true;  // Still delaying
        } else {
            // Delay expired, flush packets and stop delaying
            flushQueuedPackets();
            isDelaying = false;
            log_debug("[Criticals] Delay expired, flushing packets");
            return false;
        }
    }

    // If we were delaying but conditions no longer met, flush packets
    if (isDelaying) {
        flushQueuedPackets();
        isDelaying = false;
        log_debug("[Criticals] Conditions no longer met, flushing packets");
    }

    return false;
}

void Criticals::queuePacket(JNIEnv* env, jobject packet) {
    if (!env || !packet)
        return;

    jobject global = env->NewGlobalRef(packet);
    if (!global)
        return;

    std::lock_guard<std::mutex> lock(queueMutex);
    queuedPackets.push_back(global);
    log_debug("[Criticals] Queued packet (total=%zu)", queuedPackets.size());
}

void Criticals::flushQueuedPackets() {
    JNIEnv* env = Java::Env();
    if (!env) {
        return;
    }

    std::vector<jobject> toSend;
    {
        std::lock_guard<std::mutex> lock(queueMutex);
        toSend.swap(queuedPackets);
    }

    if (toSend.empty())
        return;

    log_debug("[Criticals] Flushing %zu queued packets", toSend.size());

    for (jobject pkt : toSend) {
        sendPacket(env, pkt);
        env->DeleteGlobalRef(pkt);
    }
    log_debug("[Criticals] Flush complete");
}

void Criticals::clearQueuedPackets() {
    JNIEnv* env = Java::Env();
    if (!env)
        return;

    std::vector<jobject> toDelete;
    {
        std::lock_guard<std::mutex> lock(queueMutex);
        toDelete.swap(queuedPackets);
    }

    for (jobject pkt : toDelete) {
        if (pkt)
            env->DeleteGlobalRef(pkt);
    }

    if (!toDelete.empty()) {
        log_debug("[Criticals] Cleared queued packets (%zu)", toDelete.size());
    }
}

void Criticals::onUpdate() {
    if (!enabled)
        return;
    if (Menu::isOpen)
        return;

    // Periodically flush packets if delay has expired
    // This handles the case where shouldDelayPacket is not called
    if (isDelaying && delayStartTime != 0) {
        ULONGLONG elapsed = GetTickCount64() - delayStartTime;
        if (elapsed >= (ULONGLONG)settings.maxDelayMs) {
            flushQueuedPackets();
            isDelaying = false;
        }
    }
}

void Criticals::onRenderMenu() {
    ui::two_column(
        "General",
        [this]() {
            ui::CheckboxBind("Enabled", &enabled, &keybind);
            ImGui::Spacing();
            ui::SliderInt("Max Delay", &settings.maxDelayMs, 10, 300, "%dms");
        },
        "Conditions",
        [this]() {
            ui::Checkbox("Only Attacking", &settings.onlyWhileAttacking);
            ui::Checkbox("Looking At Player", &settings.lookingAtPlayer);
            ui::Checkbox("Only With Sword", &settings.onlyWithSword);
        });
}