  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(ProjectDir)..\..\out\tests\menu_nav\</OutDir>
    <IntDir>$(ProjectDir)..\..\out\obj\tests\menu_nav\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- RapidCheck uses RTTI (typeid) and C++ exceptions; both enabled here.
           This is independent of the main DLL's settings (it disables RTTI). -->
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <ExceptionHandling>Sync</ExceptionHandling>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalOptions>/FS /bigobj %(AdditionalOptions)</AdditionalOptions>
      <!-- Include the model under test (src), RapidCheck headers, and this
           test dir (for generators.hpp). Paths are project-relative so the
           target builds whether invoked via the solution or the vcxproj. -->
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\..\src;$(ProjectDir)..\..\infra\ext\rapidcheck\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Test sources. Property tests 2.2-2.8 are added here as separate .cpp
         files; each includes generators.hpp. main.cpp owns main(). -->
    <ClCompile Include="main.cpp" />
    <!-- Vendored RapidCheck core sources (submodule: infra/ext/rapidcheck).
         Globbed so RapidCheck updates do not require editing this project. -->
    <ClCompile Include="..\..\infra\ext\rapidcheck\src\**\*.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="generators.hpp" />
