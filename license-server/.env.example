# Server
PORT=8080
ADMIN_KEY=change-this-secret

# Database (PostgreSQL required)
DATABASE_URL=postgres://user:password@localhost:5432/cobble?sslmode=disable

# JWT Authentication
JWT_SECRET=change-this-to-a-32-char-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# CORS (frontend URL)
FRONTEND_URL=http://localhost:3000

# Configuration
MIN_VERSION=1.0.0
MAX_HWID_COUNT=2
MAX_CONCURRENT=2

# Logging: "text" (colored) or "json"
LOG_FORMAT=text

# Updates
RELEASES_DIR=./releases
SIGNING_KEY_PATH=./private.key

# Discord Bot (optional - leave empty to disable)
DISCORD_TOKEN=
DISCORD_GUILD=
DISCORD_ADMIN_ROLE=

# Security
# Set to true in production with HTTPS domain
SECURE_COOKIES=false

# Mails
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=Cobble Security <noreply@cobble.vip>

# PayPal
PAYPAL_WEBHOOK_ID=