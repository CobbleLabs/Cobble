# Server
PORT=8080
ADMIN_KEY=change-this-secret

# Database
DB_TYPE=sqlite
DB_PATH=./licenses.db

# Configuration
MIN_VERSION=1.0.0
MAX_HWID_COUNT=2
MAX_CONCURRENT=1

# Logging: "text" (colored) or "json"
LOG_FORMAT=text

# Updates
RELEASES_DIR=./releases
SIGNING_KEY_PATH=./private.key

# Discord Bot (optional - leave empty to disable)
DISCORD_TOKEN=
DISCORD_GUILD=
DISCORD_ADMIN_ROLE=